# Copy to `.env` for local dev and fill in values. Do NOT commit `.env`.
# On Render, set these in the service's Environment tab instead (same keys).
#
# Everything here is PUBLIC_*, i.e. baked into the client bundle at build time
# and visible to anyone who views source. That is by design — none of these are
# secrets. Scope them so a scraped value can't do damage.

# Cesium Ion access token for satellite imagery + world terrain in the 3D viewer.
# Mint a dedicated token in https://ion.cesium.com/tokens scoped to read-only
# access to just the assets you use (asset 1 = Cesium World Terrain, asset 2 =
# Bing Aerial Imagery) so a scraped token can't touch anything else.
PUBLIC_CESIUM_ION_TOKEN=

# Supabase project — user accounts, annotations, pilot claims.
# Project settings -> API. Use the *anon/publishable* key, never the service
# role key: the anon key is safe to ship because row-level security is the
# boundary (supabase/migrations/0001_accounts.sql). Leave both blank to build
# with accounts switched off.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
