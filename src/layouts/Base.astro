---
// Shared page shell: head, fonts, global styles, and top nav.
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Outclimb.app',
  description = 'Outclimb.app — analyze, replay, and annotate paragliding competition flights in your browser.',
} = Astro.props;

const path = Astro.url.pathname;
// The archive is the landing page, so "/" and the /archive/… day pages are all
// one Archive section; Analyze is its own page now.
const isArchive = path === '/' || path.startsWith('/archive');
const isAnalyze = path.startsWith('/analyze');
const isNotebooks = path.startsWith('/notebooks');
const isFeedback = path.startsWith('/feedback');
// The 3D replay fills the viewport; no feedback pill there.
const is3d = /\/3d\/?$/.test(path);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@100;200;300;400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <nav class="topnav">
      <a href="/" class:list={[{ active: isArchive }]}>Archive</a>
      <a href="/analyze" class:list={[{ active: isAnalyze }]}>Analyze</a>
      {/* Account-only: nav-account.ts reveals it when a session is stored.
          Ships hidden so signed-out visitors never see a tab that would only
          bounce them to a sign-in wall. */}
      <a href="/notebooks" id="nav-notebooks" class:list={[{ active: isNotebooks }]} hidden>Notebooks</a>
      {/* Filled in by src/scripts/nav-account.ts — the session only exists client-side. */}
      <span id="nav-account" class="nav-account"></span>
    </nav>

    <slot />

    {/* Bottom band, not a nav tab. Redundant on /feedback; omitted on the
        full-screen 3D replay. */}
    {
      !isFeedback && !is3d && (
        <footer class="feedback-band">
          Found a bug, or want something the site doesn't do? <a href="/feedback">Send feedback →</a>
        </footer>
      )
    }

    <script>
      import '../scripts/nav-account';
      import '../scripts/back-chip';
      import '../scripts/breadcrumbs';
    </script>
  </body>
</html>
