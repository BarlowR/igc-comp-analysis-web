---
// Landing page: the feature list, one centred column. Each feature is an
// header that, when it has a screenshot (public/features/), expands to show it. Account-only
// features carry a small tag instead of living in a second section.
import Base from '../layouts/Base.astro';

interface Feature {
  name: string;
  /** Screenshot path. Without one the row is a plain header: no dropdown. */
  img?: string;
  account?: boolean;
}

const features: Feature[] = [
  {
    name: 'Competition Tracklog Static Analysis',
    img: '/features/analysis.png',
  },
  {
    name: 'Thermalling Quantification',
    img: '/features/thermalling.png',
  },
  {
    name: 'Time & Altitude Gain/Loss',
    img: '/features/glide.png',
  },
  {
    name: 'Cross Country & Hike and Fly Competition Archive',
  },
  {
    name: '3D replay',
    img: '/features/3d.png',
    account: true,
  },
  {
    name: 'Tracklog Annotations',
    img: '/features/annotations.png',
    account: true,
  },
  {
    name: 'Thermal Cloud Visualization',
    img: '/features/thermal-cloud.png',
    account: true,
  },
  {
    name: 'Notebooks',
    img: '/features/notebooks.png',
    account: true,
  },
  {
    name: 'Save Personal Task Analyses',
    account: true,
  },
];
---

<Base title="Features — Outclimb.app">
  <header class="hero tour-hero">
    <h1>Outclimb.app</h1>
    <h2>Break down paragliding performance from qualitative into quantitative.</h2>
    <div class="tour-hero-links">
      <a class="tour-button" href="/archive">Browse the archive</a>
      <a class="tour-button secondary" href="/analyze">Analyze a Task</a>
    </div>
  </header>

  <main class="tour">
    <div class="feature-list">
      {
        features.map((f) =>
          f.img ? (
            <details class="feature">
              <summary>
                <h2>{f.name}</h2>
                {f.account && <span class="tag">account</span>}
                <span class="chev" aria-hidden="true" />
              </summary>
              <img src={f.img} alt={f.name} loading="lazy" />
            </details>
          ) : (
            <div class="feature feature-static">
              <h2>{f.name}</h2>
              {f.account && <span class="tag">account</span>}
            </div>
          ),
        )
      }
    </div>
  </main>
</Base>

<style>
  .tour-hero {
    padding-bottom: 2.5rem;
  }

  .tour-hero h1 {
    max-width: 30ch;
    margin-inline: auto;
    font-size: clamp(2rem, 4.5vw, 3rem);
    line-height: 1.15;
    text-wrap: balance;
  }

  /* The tagline: the h1's face, smaller. */
  .tour-hero h2 {
    margin: 0.25rem auto 0;
    max-width: 36ch;
    font-size: clamp(1.2rem, 2.4vw, 1.6rem);
    font-weight: 100;
    letter-spacing: 0.01em;
    line-height: 1.3;
    color: var(--muted);
    text-wrap: balance;
  }

  .tour-hero-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .tour {
    max-width: 720px;
  }

  .feature {
    border-bottom: 1px solid var(--border);
  }

  .feature:last-child {
    border-bottom: 0;
  }

  .feature summary,
  .feature-static {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.8rem 0;
    cursor: pointer;
    list-style: none;
  }

  .feature-static {
    cursor: default;
  }

  .feature summary::-webkit-details-marker {
    display: none;
  }

  /* The h1's face again, one step smaller than the tagline's. */
  .feature h2 {
    flex: 1;
    margin: 0;
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    font-weight: 100;
    letter-spacing: 0.01em;
    line-height: 1.3;
  }

  .chev {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-right: 1px solid var(--muted);
    border-bottom: 1px solid var(--muted);
    transform: rotate(45deg);
    transition: transform 0.15s;
  }

  .feature[open] .chev {
    transform: rotate(-135deg);
  }

  .feature img {
    display: block;
    width: 100%;
    margin: 0 0 1.25rem;
    border-radius: 8px;
    border: 1px solid var(--border-strong);
    box-shadow: 0 1px 3px rgba(20, 12, 12, 0.08);
  }

  .tag {
    flex: none;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0.1rem 0.5rem;
  }

  .tour-button {
    display: inline-block;
    padding: 0.6rem 1.3rem;
    border-radius: 9px;
    background: var(--accent);
    color: #fff;
    font-weight: 400;
    text-decoration: none;
    border: 1px solid var(--accent-strong);
  }

  .tour-button:hover {
    background: var(--accent-strong);
  }

  .tour-button.secondary {
    background: var(--panel);
    color: var(--text);
    border-color: var(--border-strong);
  }

  .tour-button.secondary:hover {
    background: var(--panel-2);
  }
</style>
