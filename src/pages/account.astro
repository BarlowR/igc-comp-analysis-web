---
// Account page. Everything here is client-rendered: the site is static, so
// there is no server to know who is signed in. src/scripts/account.ts fills it.
import Base from '../layouts/Base.astro';
---

<Base title="Account — Outclimb.app">
  <header class="hero">
    <h1>Account</h1>
  </header>

  <main>
    <section class="card account-card" id="account-unconfigured" hidden>
      <h2>Accounts are off</h2>
      <p class="field-hint">
        This build has no Supabase credentials. Set <code>PUBLIC_SUPABASE_URL</code> and
        <code>PUBLIC_SUPABASE_ANON_KEY</code> (see <code>.env.example</code>) and rebuild.
      </p>
    </section>

    <section class="card account-card" id="account-loading">
      <p class="field-hint">Checking your session…</p>
      {/* Unhidden by account.ts when the check drags on — it hangs exactly when
          the account service is slow or unreachable, and a bare hint gives you
          nothing to do about it. */}
      <p id="loading-slow" class="field-hint" hidden>
        Still going! This is taking longer than it should.
        <button id="loading-skip" class="account-btn small" type="button">Continue to sign-in</button>
      </p>
    </section>

    <section class="card account-card" id="account-signed-out" hidden>
      <h2>Sign In / Sign Up</h2>
      <form id="signin-form" class="account-form">
        <label class="field-label" for="signin-email">Email</label>
        <input id="signin-email" type="email" name="email" required autocomplete="email"
          placeholder="you@example.com" />
        <label class="field-label" for="signin-password">Password</label>
        <input id="signin-password" type="password" name="password" required
          autocomplete="current-password" minlength="8" />
        <div class="account-actions-row">
          <button id="signin-submit" type="submit" class="account-btn">Sign in</button>
          <button id="signup-submit" type="button" class="account-btn ghost">Create account</button>
        </div>
      </form>
      <p id="signin-status" class="form-status" role="status" aria-live="polite"></p>
      {/* Both fall back to email: reset for a forgotten password, and the old
          magic-link flow for accounts from before passwords existed (they have
          no password until they set one under Account → Change password). The
          email arrives from "Supabase Auth" — which sender to look for is the
          one thing the flow can't show you, and why people give up waiting. */}
      <p class="field-hint account-alt">
        <button id="forgot-password" type="button" class="linklike">Forgot password?</button>
        ·
        <button id="magic-link" type="button" class="linklike">Email me a sign-in link instead</button>
      </p>
    </section>

    <section class="card account-card" id="account-signed-in" hidden>
      <h2>Your flights</h2>

      <div id="claims-list" class="claims-list"></div>
      <p id="claims-status" class="form-status" role="status" aria-live="polite"></p>

      <form id="claim-form" class="account-form claim-search">
        <label class="field-label" for="claim-query">Find your results</label>
        <input id="claim-query" type="search" autocomplete="off" placeholder="Type your name as it appears on comp trackers" />
      </form>
      <div id="claim-results" class="claim-results"></div>

      <!-- Notes you've left on flights you haven't claimed. Stays hidden until
           account-claims.ts finds any. -->
      <div id="annotated-section" hidden>
        <div class="account-divider"></div>
        <h3>Annotated Flights</h3>
        <div id="annotated-list" class="claims-list"></div>
      </div>

      <div class="account-divider"></div>

      <h3>Saved comps</h3>
      <p class="field-hint">
        Days you've analyzed and saved from the <a href="/analyze">analyze page</a>.
        <a href="/saved">View your saved comps →</a>
      </p>

      <div class="account-divider"></div>

      <h3>Account</h3>
      <p class="field-hint">Signed in as <span id="account-email" class="account-email"></span></p>

      <form id="name-form" class="account-form">
        <label class="field-label" for="display-name">Username</label>
        <input id="display-name" type="text" name="display_name" maxlength="60"
          autocomplete="name" />
        <button type="submit" class="account-btn">Save</button>
      </form>
      <p id="name-status" class="form-status" role="status" aria-live="polite"></p>

      {/* Also how a password gets SET: accounts predating passwords (magic
          link) and password-reset arrivals both land signed-in and set it here.
          account.ts points recovery arrivals at this form. */}
      <form id="password-form" class="account-form">
        <label class="field-label" for="new-password">Change password</label>
        <input id="new-password" type="password" name="new_password" minlength="8" required
          autocomplete="new-password" placeholder="At least 8 characters" />
        <button type="submit" class="account-btn">Set password</button>
      </form>
      <p id="password-status" class="form-status" role="status" aria-live="polite"></p>

      <div class="account-actions">
        <button id="sign-out" type="button" class="account-btn ghost">Sign out</button>
      </div>
    </section>
  </main>

  <script>
    import '../scripts/account';
  </script>
</Base>
