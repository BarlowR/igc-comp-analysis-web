---
// 3D tracklog viewer for an archived day. Reuses the precomputed [day].json
// analysis (turnpoints + per-pilot tracks with lat/lon/alt/time) and renders it
// on a Cesium globe with an animated, scrubbable timeline. One static route per
// manifest entry, mirroring [day].astro. The page body and every style live in
// components/Viewer3d.astro, shared with the saved-comp viewer (/saved/3d).
import Base from '../../../../layouts/Base.astro';
import Viewer3d from '../../../../components/Viewer3d.astro';
import manifest from '../../../../archive-manifest.json';

interface Entry {
  comp: string;
  compLabel?: string;
  day: string;
  dayLabel?: string;
  date?: string;
  title?: string;
  utcOffsetMinutes?: number | null;
}

export function getStaticPaths() {
  const entries = manifest as unknown as Entry[];
  return entries.map((entry) => ({ params: { comp: entry.comp, day: entry.day }, props: { entry } }));
}

const { entry } = Astro.props as { entry: Entry };
const base = `/archive/${entry.comp}/${entry.day}`;
const heading = entry.title ?? `${entry.compLabel ?? entry.comp} — ${entry.dayLabel ?? entry.day}`;
const clientEntry = { base, label: heading, utcOffsetMinutes: entry.utcOffsetMinutes ?? null };
---

<Base title={`${heading} — 3D`}>
  <Viewer3d heading={heading} backHref={base} entry={clientEntry} />
</Base>
