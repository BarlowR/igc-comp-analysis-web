---
// Prototype 3D tracklog viewer. Reuses the precomputed [day].json analysis
// (turnpoints + per-pilot tracks with lat/lon/alt/time) and renders it on a
// Cesium globe with an animated, scrubbable timeline. One static route per
// manifest entry, mirroring [day].astro.
import Base from '../../../../layouts/Base.astro';
import LoadingOverlay from '../../../../components/LoadingOverlay.astro';
import manifest from '../../../../archive-manifest.json';

interface Entry {
  comp: string;
  compLabel?: string;
  day: string;
  dayLabel?: string;
  date?: string;
  title?: string;
  utcOffsetMinutes?: number | null;
}

export function getStaticPaths() {
  const entries = manifest as unknown as Entry[];
  return entries.map((entry) => ({ params: { comp: entry.comp, day: entry.day }, props: { entry } }));
}

const { entry } = Astro.props as { entry: Entry };
const base = `/archive/${entry.comp}/${entry.day}`;
const heading = entry.title ?? `${entry.compLabel ?? entry.comp} — ${entry.dayLabel ?? entry.day}`;
const clientEntry = { base, label: heading, utcOffsetMinutes: entry.utcOffsetMinutes ?? null };
---

<Base title={`${heading} — 3D`}>
  <div class="viewer3d no-right">
    <!-- Phones only. The viewer covers the site nav, and the dock bars that
         carry these links on a wider screen are folded inside drawers here —
         so with both drawers shut there would be no way out of the page. -->
    <header class="viewer3d-top">
      <a class="backlink" href={base}>← 2D analysis</a>
      <span class="dock-account"></span>
    </header>

    <div id="cesiumContainer"></div>

    <!-- Full-screen loading overlay; track3d.ts advances the step text and fades it out. -->
    <LoadingOverlay title={heading} step="Starting the 3D viewer…" />

    <!-- Sign-in wall, revealed by gate3d.ts in place of the loading overlay when
         there's no session. The viewer script is never loaded in that case. -->
    <div id="gate3d" class="gate3d" hidden>
      <div class="gate3d-box">
        <div class="gate3d-icon" aria-hidden="true">◈</div>
        <h1>Fly this day in 3D</h1>
        <p class="gate3d-day">{heading}</p>
        <p class="gate3d-copy">
          3D Replay is for account holders. Sign-up is free: 
        </p>
        <a id="gate3d-signin" class="account-btn gate3d-btn" href="/account">
          Sign in or create an account
        </a>
        <a class="gate3d-back" href={base}>← Back to the 2D analysis</a>
      </div>
    </div>

    <!-- Shared altitude-plot scrubber (mountTimeline) is inserted after this anchor. -->
    <div class="viewer3d-bottom"><div id="timeAnchor"></div></div>

    <!-- Left dock: the pilot list. dock3d.ts drives the width + collapse. -->
    <aside id="dockLeft" class="dock dock-left">
      <div class="dock-bar">
        <a class="backlink" href={base}>← 2D analysis</a>
        <button class="dock-toggle" type="button" aria-controls="dockLeftBody">‹</button>
      </div>
      <span class="dock-rail-label" aria-hidden="true">Pilots</span>
      <div id="dockLeftBody" class="dock-body">
        <h1>{heading}</h1>
        <div id="status3d" class="status3d">Loading globe…</div>
        <div class="panel3d-controls">
          <button id="showAll" type="button">Show all</button>
          <button id="hideAll" type="button">Hide all</button>
        </div>
        <ul id="pilotList" class="pilot-list"></ul>
      </div>
      <div class="dock-grip" title="Drag to resize"></div>
    </aside>

    <!-- Right dock: notes on a moment in a pilot's flight. Ships hidden with its
         column at zero width; annotations3d.ts reveals it once a session and the
         accounts config both check out. -->
    <aside id="dockRight" class="dock dock-right" hidden>
      <div class="dock-bar">
        <button class="dock-toggle" type="button" aria-controls="dockRightBody">›</button>
        {/* The viewer covers the site nav, so this is the only way to the
            account page from here. Filled in by annotations3d.ts. */}
        <span id="notes3dAccount" class="dock-account"></span>
      </div>
      <span class="dock-rail-label" aria-hidden="true">Notes</span>
      <div id="dockRightBody" class="dock-body">
        <div id="notes3d" class="notes3d">
          <div class="notes3d-head">
            <span class="notes3d-title">Notes</span>
            <button id="noteAdd" type="button" title="Note the pinned pilot at the current time">
              ＋ Add note here
            </button>
          </div>
          <p id="notes3dStatus" class="notes3d-status" role="status" aria-live="polite"></p>
          <div id="notes3dComposer"></div>
          <ul id="notes3dList" class="notes3d-list"></ul>
        </div>
      </div>
      <div class="dock-grip" title="Drag to resize"></div>
    </aside>
  </div>

  <script type="application/json" id="archive-entry" set:html={JSON.stringify(clientEntry)} />
  <!-- Must run before the Cesium module so it finds its static assets under /cesium. -->
  <script is:inline>window.CESIUM_BASE_URL = "/cesium/";</script>
  <!-- The gate, not the viewer: track3d.ts is imported from there once a session
       checks out, so a signed-out visitor never downloads Cesium. -->
  <script>
    import '../../../../scripts/gate3d.ts';
  </script>
</Base>

<style is:global>
  /* Full-viewport docked layout: pilots left, globe centre, notes right, the
     altitude scrubber pinned along the bottom — each a real region, not a
     translucent panel floating over the map.

     The two dock columns are custom properties so dock3d.ts can resize them with
     a single style write; the map column (1fr) takes whatever is left. Values
     here are only the pre-JS defaults. */
  .viewer3d {
    --dock-left: 320px;
    --dock-right: 320px;
    position: fixed;
    inset: 0;
    display: grid;
    grid-template-columns: var(--dock-left) 1fr var(--dock-right);
    /* The top row is a phone's header; it has no item on wider screens and
       collapses to nothing there. */
    grid-template-rows: auto 1fr auto;
    grid-template-areas:
      'top top top'
      'left map right'
      'slider slider slider';
    background: var(--bg, #e7e7e7);
  }
  .viewer3d-top {
    grid-area: top;
    display: none;
  }
  /* No notes dock (accounts off, or not signed in): collapse its column away. */
  .viewer3d.no-right {
    --dock-right: 0px;
  }
  #cesiumContainer {
    grid-area: map;
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 0;
  }
  /* The loading overlay itself is components/LoadingOverlay.astro, shared with
     the 2D analysis page. */

  /* Sign-in wall. Same full-cover footprint as the loading overlay — .viewer3d
     is fixed inset:0, so this hides the top nav too and has to carry its own way
     out (the sign-in button and the back link). */
  .gate3d {
    position: absolute;
    inset: 0;
    z-index: 25;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background: var(--bg, #e7e7e7);
  }
  /* display:grid would otherwise beat the hidden attribute. */
  .gate3d[hidden] {
    display: none;
  }
  .gate3d-box {
    max-width: min(90vw, 26rem);
    text-align: center;
  }
  .gate3d-icon {
    font-size: 1.6rem;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }
  .gate3d h1 {
    font-size: 1.35rem;
    font-weight: 400;
    margin: 0;
    line-height: 1.25;
  }
  .gate3d-day {
    margin: 0.3rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .gate3d-copy {
    margin: 1rem 0 1.4rem;
    color: var(--text);
    line-height: 1.5;
  }
  /* .account-btn is styled for <button>; as a link it needs these two. */
  .gate3d-btn {
    display: inline-block;
    text-decoration: none;
  }
  .gate3d-back {
    display: block;
    margin-top: 1.2rem;
    font-size: 0.85rem;
    color: var(--muted);
    text-decoration: none;
  }
  .gate3d-back:hover,
  .gate3d-back:focus-visible {
    color: var(--accent);
    text-decoration: underline;
  }

  /* Bottom dock holding the shared altitude-plot scrubber. */
  .viewer3d-bottom {
    grid-area: slider;
    padding: 0.5rem 0.9rem 0.7rem;
    background: #fff;
    border-top: 1px solid rgba(0, 0, 0, 0.12);
  }
  /* The reused .time-slider adds a top margin we don't want as the first child. */
  .viewer3d-bottom .time-slider {
    margin-top: 0;
  }

  /* ---- side docks (dock3d.ts) ------------------------------------------- */
  /* Registering the two column widths is what makes them animatable: an
     unregistered custom property is just a token and jumps. dock3d.ts writes
     them, the grid above consumes them, and the transition below carries a dock
     open or shut instead of snapping it. */
  @property --dock-left {
    syntax: '<length>';
    inherits: true;
    initial-value: 320px;
  }
  @property --dock-right {
    syntax: '<length>';
    inherits: true;
    initial-value: 320px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .viewer3d {
      transition:
        --dock-left 220ms ease,
        --dock-right 220ms ease;
    }
    /* A drag is direct manipulation: the edge belongs under the pointer, not
       220ms behind it. */
    .viewer3d.dock-dragging {
      transition: none;
    }
    /* Phones: the panel slides up out of the tab row, which doesn't move. */
    .viewer3d.compact .dock-body {
      transition:
        height 220ms ease,
        padding-top 220ms ease,
        padding-bottom 220ms ease;
    }
  }

  .dock {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    background: #fff;
    font-size: 0.85rem;
  }
  .dock[hidden] {
    display: none;
  }
  .dock-left {
    grid-area: left;
    border-right: 1px solid rgba(0, 0, 0, 0.12);
  }
  .dock-right {
    grid-area: right;
    border-left: 1px solid rgba(0, 0, 0, 0.12);
  }
  /* Thin bar carrying the collapse toggle, and whatever link belongs to that
     side. Survives collapsing — it's what you click to get the dock back. */
  .dock-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.35rem 0.15rem;
    min-height: 1.65rem;
  }
  .dock-left .dock-bar {
    padding-left: 0.9rem;
  }
  .dock-right .dock-bar {
    padding-right: 0.9rem;
  }
  .dock-left .backlink {
    margin-right: auto;
  }
  .dock-right .dock-account {
    margin-left: auto;
  }
  .dock.collapsed .dock-bar > :not(.dock-toggle) {
    display: none;
  }
  .dock-toggle {
    flex: none;
    width: 1.35rem;
    height: 1.35rem;
    display: grid;
    place-items: center;
    padding: 0;
    border: 1px solid rgba(0, 0, 0, 0.18);
    border-radius: 5px;
    background: #fff;
    color: var(--muted);
    font: inherit;
    line-height: 1;
    cursor: pointer;
  }
  .dock-toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  /* Sideways title down the rail, so a collapsed dock still says what it is. */
  .dock-rail-label {
    display: none;
    writing-mode: vertical-rl;
    margin: 0.5rem auto 0;
    color: var(--muted);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    user-select: none;
  }
  .dock.collapsed .dock-rail-label {
    display: block;
  }
  .dock-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    padding: 0.2rem 0.9rem 0.75rem;
    overflow: hidden;
    /* Sizing context for the pilot rows: they answer to the dock's width, which
       is dragged and screen-dependent, not to the viewport's. */
    container-type: inline-size;
  }
  .dock.collapsed .dock-body {
    display: none;
  }
  /* Resize handle on the map-facing edge. */
  .dock-grip {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 7px;
    z-index: 2;
    cursor: col-resize;
  }
  .dock-left .dock-grip {
    right: 0;
  }
  .dock-right .dock-grip {
    left: 0;
  }
  .dock-grip:hover {
    background: rgba(112, 90, 144, 0.25);
  }
  .dock.collapsed .dock-grip {
    display: none;
  }
  .dock-account a {
    font-size: 0.8rem;
    white-space: nowrap;
    color: var(--muted);
    text-decoration: none;
  }
  .dock-account a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .dock h1 {
    font-size: 0.98rem;
    font-weight: 500;
    margin: 0 0 0.15rem;
    line-height: 1.25;
  }
  .backlink {
    white-space: nowrap;
    font-size: 0.8rem;
    color: var(--muted);
    text-decoration: none;
  }
  .backlink:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .status3d {
    color: #6b655c;
    margin: 0.25rem 0 0.5rem;
  }
  .panel3d-controls {
    display: flex;
    gap: 0.4rem;
    margin-bottom: 0.5rem;
  }
  .panel3d-controls button {
    font: inherit;
    padding: 0.2rem 0.55rem;
    border: 1px solid rgba(0, 0, 0, 0.2);
    border-radius: 6px;
    background: #fff;
    cursor: pointer;
  }
  .pilot-list {
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
    min-height: 0;
    overflow-y: auto;
  }
  .pilot-list li {
    display: grid;
    grid-template-columns: 1.6em 1.15em minmax(0, 1fr) 3.4em 2.6em 2.9em;
    align-items: center;
    gap: 0.4rem;
    padding: 0.06rem 0.15rem;
    border-radius: 4px;
  }
  .pilot-list li.head {
    position: sticky;
    top: 0;
    z-index: 1;
    background: #fff;
    color: var(--muted);
    font-size: 0.72rem;
    padding-bottom: 0.2rem;
  }
  .pilot-list .rank {
    color: #9a948a;
    font-variant-numeric: tabular-nums;
    text-align: right;
    font-size: 0.78rem;
  }
  .pilot-list .sel-check {
    margin: 0;
    cursor: pointer;
  }
  .pilot-list .nm {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    cursor: pointer;
  }
  .pilot-list .stat {
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    text-align: right;
    font-size: 0.8rem;
  }
  .pilot-list li.off .rank,
  .pilot-list li.off .nm,
  .pilot-list li.off .stat {
    opacity: 0.45;
  }
  .pilot-list li.pinned {
    background: rgba(112, 90, 144, 0.16);
  }
  .pilot-list li.pinned .nm {
    font-weight: 500;
  }

  /* A narrow dock — dragged in, or a phone sheet — can't hold six columns, and
     six columns of nothing is worse than four that read. Height and speed go;
     rank, colour, name and altitude stay. Column 4 is the altitude stat, 5 and 6
     the climb rate and speed (see the row built in track3d.ts). */
  @container (max-width: 280px) {
    .pilot-list li {
      grid-template-columns: 1.6em 1.15em minmax(0, 1fr) 3.4em;
    }
    .pilot-list li > :nth-child(5),
    .pilot-list li > :nth-child(6) {
      display: none;
    }
  }

  /* Half a phone screen. Altitude goes too — a row that can't name its pilot
     isn't telling you anything. */
  @container (max-width: 205px) {
    .pilot-list li {
      grid-template-columns: 1.6em 1.15em minmax(0, 1fr);
    }
    .pilot-list li > :nth-child(4) {
      display: none;
    }
  }

  /* ---- notes (annotations3d.ts) ----------------------------------------- */
  /* Fills the right dock; the list scrolls, the head and composer don't. */
  .notes3d {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
  }
  .notes3d-head {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    flex-wrap: wrap;
  }
  .notes3d-title {
    font-weight: 500;
    margin-right: auto;
  }
  .notes3d-head button {
    font: inherit;
    font-size: 0.78rem;
    padding: 0.15rem 0.45rem;
    border: 1px solid rgba(0, 0, 0, 0.2);
    border-radius: 6px;
    background: #fff;
    cursor: pointer;
    white-space: nowrap;
  }
  .notes3d-head button:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .notes3d-status {
    margin: 0.3rem 0 0;
    font-size: 0.78rem;
    color: var(--muted);
    line-height: 1.35;
  }
  .notes3d-status:empty {
    display: none;
  }
  .notes3d-status.error {
    color: #9b2c2c;
  }
  .notes3d-list {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    overflow-y: auto;
    min-height: 0;
  }
  .notes3d-empty {
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.4;
  }
  .note-row {
    display: grid;
    grid-template-columns: 1.5em minmax(0, 1fr);
    gap: 0.45rem;
    padding: 0.3rem 0.25rem;
    border-radius: 5px;
    cursor: pointer;
  }
  .note-row:hover {
    background: rgba(0, 0, 0, 0.035);
  }
  .note-row.focused {
    background: rgba(112, 90, 144, 0.16);
  }
  /* The note's pilot has no track on this day — it can be read and deleted, but
     there is nowhere to draw it. */
  .note-row.orphan .note-meta {
    text-decoration: line-through;
  }
  .note-index {
    justify-self: start;
    min-width: 1.5em;
    padding: 0.05rem 0;
    border-radius: 4px;
    color: #fff;
    font-size: 0.72rem;
    text-align: center;
    line-height: 1.5;
  }
  .note-meta {
    color: var(--muted);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .note-body {
    font-size: 0.82rem;
    line-height: 1.4;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .note-actions {
    display: none;
    gap: 0.3rem;
    margin-top: 0.2rem;
  }
  .note-row:hover .note-actions,
  .note-row.focused .note-actions {
    display: flex;
  }
  .note-btn {
    font: inherit;
    font-size: 0.72rem;
    padding: 0.1rem 0.4rem;
    border: 1px solid rgba(0, 0, 0, 0.18);
    border-radius: 5px;
    background: #fff;
    color: var(--muted);
    cursor: pointer;
  }
  .note-btn:hover:not(:disabled) {
    color: var(--text);
    border-color: var(--accent);
  }
  .note-btn.danger:hover:not(:disabled) {
    color: #9b2c2c;
    border-color: #9b2c2c;
  }
  .note-compose {
    margin-top: 0.45rem;
    padding: 0.5rem;
    border: 1px solid var(--accent);
    border-radius: 7px;
    background: rgba(112, 90, 144, 0.06);
  }
  .note-compose-head {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .note-dot {
    width: 0.6em;
    height: 0.6em;
    border-radius: 50%;
    flex: none;
  }
  /* Says that the moment isn't locked in — scrubbing while this is open moves it. */
  .note-compose-hint {
    margin: 0.3rem 0 0;
    color: var(--muted);
    font-size: 0.72rem;
    line-height: 1.35;
  }
  .note-compose-text {
    width: 100%;
    margin-top: 0.35rem;
    padding: 0.4rem 0.5rem;
    border: 1px solid rgba(0, 0, 0, 0.2);
    border-radius: 6px;
    font: inherit;
    font-size: 0.82rem;
    resize: vertical;
  }
  .note-compose-text:focus-visible {
    outline: none;
    border-color: var(--accent);
  }
  .note-compose-actions {
    display: flex;
    gap: 0.4rem;
    margin-top: 0.35rem;
  }

  /* ---- phones (dock3d.ts adds .compact below the same breakpoint) --------
     A dock wide enough to read costs more width than a phone can spare, so the
     docks give up their columns and become drawers up from the bottom of the
     map: full width, one at a time, closing to a tab in a bottom corner. Both
     move into the map cell rather than going position:absolute, which is what
     keeps them inside the map row — the scrubber below is the one control that
     must never be covered. */
  @media (max-width: 700px) {
    /* Not gated on .compact: the way out of the viewer shouldn't wait on the
       dock script having run. */
    .viewer3d-top {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.4rem 0.75rem;
      background: #fff;
      border-bottom: 1px solid rgba(0, 0, 0, 0.12);
    }
    .viewer3d-top .dock-account {
      margin-left: auto;
    }
    /* The header carries these on phones, so the dock-bar copies are noise. */
    .viewer3d.compact .dock-bar .backlink,
    .viewer3d.compact .dock-bar .dock-account {
      display: none;
    }
    /* Each dock is a tab on the map's bottom edge — half the width each, always
       there, open or shut. Opening doesn't move the tab; it grows the panel out
       from behind the tab row. */
    .viewer3d.compact .dock {
      --drawer-h: min(50vh, 30rem);
      --tab-h: 2.6rem;
      grid-area: map;
      align-self: end;
      flex-direction: row;
      align-items: center;
      justify-content: center;
      width: 50%;
      height: var(--tab-h);
      z-index: 8;
      /* Only the top edge and the seam between the two tabs are borders worth
         drawing: a side border against the screen edge reads as a stray line of
         background down the outside of the bar. */
      border: none;
      border-top: 1px solid rgba(0, 0, 0, 0.14);
      /* The tab itself opens and shuts the drawer (dock3d.ts) — the chevron is
         a label for that, not the only way in. */
      cursor: pointer;
    }
    /* A shut tab sits above the open one's panel, so the way across is never
       buried — the two together always read as one bar. */
    .viewer3d.compact .dock.collapsed {
      z-index: 9;
    }
    .viewer3d.compact .dock-left {
      justify-self: start;
      border-right: 1px solid rgba(0, 0, 0, 0.14);
    }
    /* The seam is the left tab's right edge alone — both sides drawing it would
       double the line where they meet. */
    .viewer3d.compact .dock-right {
      justify-self: end;
      border-left: none;
    }

    /* The panel itself: full width, anchored to the top edge of its own tab, and
