---
// Analyze your own task: upload a .xctsk + IGC tracklogs and run the full
// analysis client-side (scripts/app.ts → runAnalysis). The archive lives at "/";
// this page is for days we don't host.
import Base from '../layouts/Base.astro';
import { TASK_KINDS, TASK_KIND_LABELS, DEFAULT_TASK_KIND } from '../lib/xctsk';

// Task kind can't be read from the .xctsk (XContest calls every one of these
// "CLASSIC"), so it's asked for here. It picks the metric set — see
// competition.ts `metricsFor`. Free Flight is the task-less kind: no .xctsk at
// all (scripts/app.ts hides that input), whole-flight analysis, and its own
// account-only tab on the archive page when saved.
const KIND_OPTIONS = [
  ...TASK_KINDS.map((kind) => ({ value: kind as string, label: TASK_KIND_LABELS[kind] })),
  { value: 'free', label: TASK_KIND_LABELS.free },
];
---

<Base title="Analyze — Outclimb.app">
  <header class="hero">
    <h1>Analyze</h1>
  </header>

  <main>
    <section class="card uploader">
      <fieldset class="kind-field">
        <legend class="field-label">Task type</legend>
        <div class="kind-options">
          {
            KIND_OPTIONS.map((opt) => (
              <label class="kind-option">
                <input
                  type="radio"
                  name="task-kind"
                  value={opt.value}
                  checked={opt.value === DEFAULT_TASK_KIND}
                />
                <span class="kind-name">{opt.label}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="drop">
        {/* Hidden by scripts/app.ts when Free Flight is picked — a free flight
            has no task, and the two comp kinds can't run without one. */}
        <label class="file-field" id="task-field">
          <span class="field-label">Task file <code>.xctsk</code></span>
          <input id="task-input" type="file" accept=".xctsk,application/json" />
          <span id="task-name" class="field-hint">No task file selected</span>
        </label>

        <label class="file-field">
          <span class="field-label">Pilot tracklogs <code>.igc</code></span>
          <input id="igc-input" type="file" accept=".igc" multiple />
          <span id="igc-count" class="field-hint">No IGC files selected</span>
        </label>
      </div>

      <div class="actions">
        <button id="analyze-btn" type="button" disabled>Analyze flights</button>
        <span id="status" class="status"></span>
      </div>
    </section>

    <!-- Appears once an analysis has run. Signed out it holds a sign-in link;
         signed in, a name + save form (src/scripts/app.ts drives both). -->
    <section class="card save-card" id="save-card" hidden>
      <form id="save-form" class="account-form save-form" hidden>
        <label class="field-label" for="save-name">Save to your account</label>
        <input id="save-name" type="text" maxlength="120" required placeholder="Task name" />
        {/* File the task under one of the account's comps — or start a new one,
            which reveals the name input. app.ts fills the options in. */}
        <label class="field-label" for="save-comp">Comp</label>
        <select id="save-comp">
          <option value="">No comp</option>
          <option value="__new__">＋ New comp…</option>
        </select>
        <input id="save-comp-name" type="text" maxlength="120" placeholder="New comp name" hidden />
        <button id="save-submit" type="submit" class="account-btn">Save task</button>
      </form>
      <p id="save-signin" class="field-hint" hidden>
        <a href="/account?next=/analyze">Sign in</a> to save this analysis.
      </p>
      <p id="save-status" class="form-status" role="status" aria-live="polite"></p>
    </section>

    <div id="results" class="results"></div>
  </main>

  <script>
    import '../scripts/app.ts';
  </script>
</Base>
